<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bmicalculator.BMIController">
    <children>
        <Label layoutX="115.0" layoutY="25.0" text="BMI Calculator">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label layoutX="40.0" layoutY="90.0" text="Berat Badan (kg):" />
        <TextField fx:id="txtBerat" layoutX="170.0" layoutY="85.0" prefHeight="25.0" prefWidth="170.0" />
        
        <Label layoutX="40.0" layoutY="140.0" text="Tinggi Badan (cm):" />
        <TextField fx:id="txtTinggi" layoutX="170.0" layoutY="135.0" prefHeight="25.0" prefWidth="170.0" />
        
        <Button layoutX="170.0" layoutY="190.0" mnemonicParsing="false" onAction="#hitungBMI" prefHeight="25.0" prefWidth="170.0" text="Hitung BMI" />
        
        <Label fx:id="lblHasil" layoutX="40.0" layoutY="240.0" prefHeight="17.0" prefWidth="300.0" text="Hasil akan muncul di sini..." textFill="#002fff">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
    </children>
</AnchorPane>